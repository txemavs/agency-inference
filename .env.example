# ─────────────────────────────────────────────────────────────
# agency-inference - Environment Configuration
# Copy this file to .env and adjust values as needed
# ─────────────────────────────────────────────────────────────

# ┌─────────────────────────────────────────────────────────────
# │ OLLAMA CONFIGURATION
# └─────────────────────────────────────────────────────────────
# Port to expose Ollama API (default: 11434)
OLLAMA_PORT=11434

# Path to store Ollama models (default: Docker named volume)
# Use absolute path for local storage, e.g.: /home/user/ollama-models
OLLAMA_MODELS=ollama_data

# ┌─────────────────────────────────────────────────────────────
# │ vLLM CONFIGURATION (optional profile)
# └─────────────────────────────────────────────────────────────
# Port to expose vLLM OpenAI-compatible API (default: 8000)
VLLM_PORT=8000

# Path to store HuggingFace models (default: Docker named volume)
# Use absolute path for local storage, e.g.: /home/user/hf-models
VLLM_MODELS=vllm_data

# Model to serve with vLLM (REQUIRED if using vllm profile)
# Examples:
#   meta-llama/Llama-3.2-1B-Instruct  (small, ~2GB VRAM)
#   meta-llama/Llama-3.1-8B-Instruct  (medium, ~16GB VRAM)
#   mistralai/Mistral-7B-Instruct-v0.3
# See: https://huggingface.co/models?pipeline_tag=text-generation
VLLM_MODEL=meta-llama/Llama-3.2-1B-Instruct

# ┌─────────────────────────────────────────────────────────────
# │ COMFYUI CONFIGURATION (optional profile)
# └─────────────────────────────────────────────────────────────
# Port to expose ComfyUI web interface (default: 8188)
COMFY_PORT=8188

# Paths to store ComfyUI data (default: Docker named volumes)
# Use absolute paths for local storage, e.g.: /home/user/comfy-models
COMFY_MODELS=comfy_models
COMFY_OUTPUT=comfy_output
COMFY_INPUT=comfy_input
COMFY_CUSTOM_NODES=comfy_custom_nodes

# Extra CLI args for ComfyUI (e.g. --lowvram --preview-method auto)
# Default includes --listen 0.0.0.0 --port 8188
# ⚠️ VRAM Warning: ComfyUI + SD checkpoints need 4-8GB+ VRAM.
#    Use --lowvram or --cpu for constrained GPUs.
COMFY_EXTRA_ARGS=--listen 0.0.0.0 --port 8188

# ┌─────────────────────────────────────────────────────────────
# │ VOICE CONFIGURATION (optional profile) - STT/TTS
# └─────────────────────────────────────────────────────────────
# Port to expose Voice API (default: 5002)
# OpenAI-compatible endpoints: /v1/audio/transcriptions, /v1/audio/speech
VOICE_PORT=5002

# Path to store voice models (default: Docker named volume)
VOICE_MODELS=voice_models

# STT model (Whisper variant)
# Options: Systran/faster-whisper-large-v3, Systran/faster-distil-whisper-small.en
VOICE_STT_MODEL=Systran/faster-whisper-large-v3

# STT compute type (float16 for GPU, int8 for CPU/low VRAM)
VOICE_STT_COMPUTE=float16

# TTS model
VOICE_TTS_MODEL=hexgrad/Kokoro-82M

# TTS language code (a=American English, b=British English)
VOICE_TTS_LANG=a

# ┌─────────────────────────────────────────────────────────────
# │ CAPABILITIES SERVICE (optional profile)
# └─────────────────────────────────────────────────────────────
# Port to expose capabilities.json for Agency discovery (default: 9090)
CAPABILITIES_PORT=9090
